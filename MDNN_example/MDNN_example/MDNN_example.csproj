<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Odkaz na knihovnu předpokládá, že repozitáře MDNN a MDNN_examples jsou naklonované
      VEDLE SEBE ve stejné složce:

          ...
           ├── MDNN
           └── MDNN_examples     <- tenhle repozitář

      Dřív tu byl absolutní HintPath na C:\Users\Martin\source\repos\... , takže projekt
      nešel přeložit nikde jinde než na jednom konkrétním Windows stroji. ProjectReference
      navíc knihovnu vždycky přestaví, takže se netestuje proti zastaralé DLL.

      Když máš MDNN jinde, uprav cestu (nebo použij Reference + HintPath na svoji MDNN.dll).
    -->
    <ProjectReference Include="../../../MDNN/MDNN/MDNN/MDNN/MDNN.csproj" />
  </ItemGroup>

</Project>
